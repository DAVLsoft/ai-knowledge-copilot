ENVIRONMENT=local
DEBUG=false
JWT_SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# localhost -> app runs on host (PyCharm); docker-compose overrides to "db"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=app
